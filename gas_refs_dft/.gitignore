# POTCARs are licensed -- never commit them. make_potcars.sh rebuilds them from
# your own VASP distribution on whatever machine you are running on.
POTCAR

# VASP run products. These are written in place next to the inputs, so a working
# copy on scratch fills up with them; results are rsynced to $PROJECT/runs/ instead.
OUTCAR
CONTCAR
vasp.log
DONE
CHG*
WAVECAR
vasprun.xml
XDATCAR
OSZICAR
IBZKPT
PCDAT
REPORT
